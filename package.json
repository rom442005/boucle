{
  "name": "boucle",
  "private": true,
  "version": "1.0.0",
  "description": "Boucle : créer des parcours de course et de vélo à partir de quelques réglages.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
