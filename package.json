    "e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs",
    "ios": "vite build --mode native && cap sync ios",
    "ios:ouvrir": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
